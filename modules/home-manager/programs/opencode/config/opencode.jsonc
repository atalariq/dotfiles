{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-5.3-flash-free",
  "update": "disable",
  "mcp": {
    "servers": {}
  },
  "lsp": true,
  "formatter": true,
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/Grimoire/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "~/Grimoire/*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "~/Grimoire/logs/agents/opencode/*",
      "effect": "allow"
    }
  ],
  "agents": {
    "title": {
      "model": "opencode/glm-5.3-flash-free"
    },
    "summary": {
      "model": "opencode/glm-5.3-flash-free"
    },
    "compaction": {
      "model": "opencode/glm-5.3-flash-free"
    }
  }
}
