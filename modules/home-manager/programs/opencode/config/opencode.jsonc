{
  "$schema": "https://opencode.ai/config.json",
  "model": "omniroute/coding-free",
  "update": "disable",
  "mcp": {
    "servers": {}
  },
  "lsp": true,
  "formatter": true,
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.agekey",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/sops/age/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/sops-nix/secrets/**",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "agents": {
    "title": {
      "model": "omniroute/coding-free"
    },
    "summary": {
      "model": "omniroute/coding-free"
    },
    "compaction": {
      "model": "omniroute/coding-free"
    }
  },
  "providers": {
    "omniroute": {
      "name": "OmniRoute (local)",
      "package": "@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "{file:~/.config/sops-nix/secrets/opencode-key}"
      },
      "models": {
        "coding-free": {
          "name": "Free coding",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "coding-paid": {
          "name": "Paid coding (disabled until budget verification)",
          "disabled": true
        }
      }
    }
  }
}
