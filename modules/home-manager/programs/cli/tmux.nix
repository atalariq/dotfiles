{
  config,
  pkgs,
  lib,
  dotfilesLib,
  ...
}:
let
  cfg = config.dotfiles.programs.cli.tmux;
  # Declarative plugin set. Add or remove a plugin here; the generated
  # plugins.conf points tmux at the store path. Plugin settings stay in the
  # live tmux.conf so they can be tuned without a rebuild.
  plugins = with pkgs.tmuxPlugins; [
    resurrect
    continuum
    yank
    tmux-fzf
    tmux-sessionx
    tmux-floax
  ];
in
{
  options.dotfiles.programs.cli.tmux.enable = lib.mkOption {
    type = lib.types.bool;
    default = true;
    description = "tmux configuration";
  };

  config = lib.mkIf (config.dotfiles.programs.cli.enable && cfg.enable) {
    home.packages = with pkgs; [ tmux ];
    xdg.configFile = {
      # The main file is native/live; theme and plugin run-shell lines are
      # generated so Stylix and the Nix plugin set stay authoritative.
      "tmux/tmux.conf".source = dotfilesLib.sourceFor "tmux" ./config/tmux/tmux.conf;
      "tmux/sensible.conf".text = "run-shell ${pkgs.tmuxPlugins.sensible.rtp}\n";
      "tmux/plugins.conf".text = ''
        # Generated by modules/home-manager/programs/cli/tmux.nix.
        ${lib.concatMapStringsSep "\n" (p: "run-shell ${p.rtp}") plugins}
      '';
    };
  };
}
