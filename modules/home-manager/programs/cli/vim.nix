{
  config,
  pkgs,
  lib,
  ...
}:
let
  source = import ../../lib/source.nix { inherit config; };
in
{

  options.dotfiles.programs.cli.vim.enable = lib.mkOption {
    type = lib.types.bool;
    default = true;
    description = "vim configuration";
  };

  config = lib.mkIf (config.dotfiles.programs.cli.enable && config.dotfiles.programs.cli.vim.enable) {

    home.packages = with pkgs; [ vim ];
    home.file.".vimrc".source =
      source ./config/vim/vimrc "modules/home-manager/programs/cli/config/vim/vimrc";
    # The colorscheme is generated by Stylix when appearance is enabled.
    home.file.".vim/colors/dotfiles.vim".source = lib.mkIf (!config.dotfiles.appearance.enable) (
      source ./config/vim/colors/dotfiles.vim "modules/home-manager/programs/cli/config/vim/colors/dotfiles.vim"
    );

  };
}
