#!/usr/bin/env bash
# First invocation watches focus continuously; a second confirms within 600 ms.
set -euo pipefail
umask 077
state="${XDG_RUNTIME_DIR:?}/dotfiles-close"
mkdir -p "$state"
exec 9>"$state/lock"
flock 9
session=$(capture-window session)
id=$(capture-window json | jq -er '.id | select(. != null and . != "") | tostring | select(test("^[A-Za-z0-9-]+$"))')
read -r uptime _ </proc/uptime
now=${uptime/./}
# /proc/uptime uses centiseconds; avoid wall-clock jumps.
exec 8>"$state/owner.lock"
if ! flock -n 8; then
	[[ -f "$state/armed" ]] || exit 0
	read -r previous_session previous_id deadline <"$state/armed"
	if [[ "$session" == "$previous_session" && "$id" == "$previous_id" && "$now" -le "$deadline" && -f "$state/ready" && ! -f "$state/invalid" ]]; then
		: >"$state/confirmed"
		exit 0
	fi
	# Do not let the old watcher close or remove a newer invocation's state.
	exit 0
fi
rm -f "$state/confirmed" "$state/invalid" "$state/ready"
printf '%s %s %s\n' "$session" "$id" "$((now + 60))" >"$state/armed"
# Establish the event subscription before showing the reminder. Events include
# transient focus changes, including a change away and back to the same window.
(
	timeout 0.65 capture-window watch | while IFS= read -r focused; do
		if [[ "$focused" != "$id" ]]; then : >"$state/invalid"; fi
		: >"$state/ready"
	done || true
	: >"$state/invalid"
) &
watcher=$!
cleanup() {
	wait "$watcher" 2>/dev/null || true
	flock 9
	rm -f "$state/armed" "$state/confirmed" "$state/invalid" "$state/ready"
}
trap cleanup EXIT
flock -u 9
notify-send -t 600 'Close window?' 'Press Win+Q again within 600 ms.' &
while :; do
	read -r uptime _ </proc/uptime
	now=${uptime/./}
	read -r _ _ expires <"$state/armed"
	[[ "$now" -le "$expires" ]] || break
	[[ ! -f "$state/invalid" ]] || break
	if [[ -f "$state/confirmed" ]]; then
		[[ "$(capture-window session)" == "$session" ]] || break
		[[ "$(capture-window json | jq -r .id)" == "$id" ]] || break
		capture-window close "$id"
		break
	fi
	sleep 0.01
done
