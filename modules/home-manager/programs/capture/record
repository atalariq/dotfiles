#!/usr/bin/env bash
# Controller and service worker share a private request; no global recorder PIDs.
set -euo pipefail
umask 077
state="${XDG_RUNTIME_DIR:?}/dotfiles-record"
unit=dotfiles-record.service
mkdir -p "$state"
if [[ "${1:-}" == worker ]]; then
	request=$(cat "$state/request.json")
	export XDG_SESSION_TYPE=wayland
	export WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_ID MANGO_INSTANCE_SIGNATURE
	WAYLAND_DISPLAY=$(jq -r '.environment.WAYLAND_DISPLAY' <<<"$request")
	XDG_CURRENT_DESKTOP=$(jq -r '.environment.XDG_CURRENT_DESKTOP' <<<"$request")
	XDG_SESSION_ID=$(jq -r '.environment.XDG_SESSION_ID' <<<"$request")
	MANGO_INSTANCE_SIGNATURE=$(jq -r '.environment.MANGO_INSTANCE_SIGNATURE' <<<"$request")
	[[ "$(capture-window session)" == "$(jq -r .session <<<"$request")" ]]
	mapfile -d '' -t args < <(jq -j '.args[] | ., "\u0000"' <<<"$request")
	exec gpu-screen-recorder "${args[@]}"
fi
exec 9>"$state/lock"
flock 9
active() { systemctl --user is-active --quiet "$unit"; }
fail() {
	notify-send -u critical 'Recording failed' "$*"
	exit 1
}
stop() {
	# Blocking stop waits for SIGINT/finalization. Never infer success from a PID.
	systemctl --user stop "$unit" || fail 'Could not stop recorder; inspect the user journal.'
	result=$(systemctl --user show "$unit" -p Result --value)
	[[ "$result" == success ]] || fail "Recorder result: $result; partial file retained."
	file=$(jq -er .file "$state/request.json")
	ffprobe -v error -show_streams -show_format -of json "$file" |
		jq -e '([.streams[] | select(.codec_type == "video")] | length > 0) and ((.format.duration | tonumber) > 0)' >/dev/null || fail 'MP4 did not finalize; partial file retained.'
	notify-send 'Recording saved' "$file"
}
case "${1:-status}" in
status)
	systemctl --user status "$unit"
	exit $?
	;;
stop)
	stop
	exit
	;;
start | toggle | area)
	# Both bindings stop the current recording before any new selector is shown.
	if active; then
		stop
		exit
	fi
	;;
*)
	echo 'Usage: shot record start|toggle|area|stop|status' >&2
	exit 2
	;;
esac
session=$(capture-window session)
outputs=$(capture-window outputs)
if [[ "$1" == area ]]; then
	geometry=$(slurp) || exit 0
	[[ -n "$geometry" ]] || exit 0
	selection=$(jq -en --arg g "$geometry" --argjson outputs "$outputs" '
    $g | capture("^(?<x>-?[0-9]+),(?<y>-?[0-9]+) (?<w>[0-9]+)x(?<h>[0-9]+)$") |
    map_values(tonumber) | . as $r |
    [$outputs[] | select(.enabled and $r.w > 0 and $r.h > 0 and
      $r.x >= .position.x and $r.y >= .position.y and
      $r.x + $r.w <= .position.x + .logical_size.width and
      $r.y + $r.h <= .position.y + .logical_size.height)] |
    if length != 1 then error("Select an area wholly inside one output") else
      .[0] as $o | {source: "region", region: "\($r.w)x\($r.h)+\($r.x)+\($r.y)",
      size: "\((($r.w * ($o.scale // 1) / 2) | floor) * 2)x\((($r.h * ($o.scale // 1) / 2) | floor) * 2)"} end') || fail 'Select an area wholly inside one output.'
else
	output=$(capture-window output)
	selection=$(jq -ec --arg name "$output" 'map(select(.enabled and .name == $name)) | first |
    {source: .name, size: "\(((.logical_size.width * (.scale // 1) / 2) | floor) * 2)x\(((.logical_size.height * (.scale // 1) / 2) | floor) * 2)"}' <<<"$outputs")
fi
jq -e '.size | test("^[1-9][0-9]*x[1-9][0-9]*$")' <<<"$selection" >/dev/null || fail 'Selected area is too small for H.264.'
[[ "$(capture-window session)" == "$session" ]] || fail 'Session changed during selection.'
# Resolve the output sink monitor explicitly; no default input/microphone.
sink=$(pactl get-default-sink)
monitor="$sink.monitor"
pactl --format=json list sources | jq -e --arg name "$monitor" 'any(.[]; .name == $name and .monitor_of_sink != null and .monitor_of_sink != 4294967295)' >/dev/null || fail 'No monitor source for the output sink.'
dir="$(xdg-user-dir VIDEOS 2>/dev/null || printf '%s/Videos' "$HOME")/Recordings"
mkdir -p "$dir"
file=$(mktemp "$dir/rec-$(date +%Y%m%d-%H%M%S)-XXXXXX.mp4")
args=(-w "$(jq -r .source <<<"$selection")" -s "$(jq -r .size <<<"$selection")" -f 60 -c mp4 -k h264 -encoder gpu -fallback-cpu-encoding yes -a "$monitor" -o "$file")
if [[ "$1" == area ]]; then args+=(-region "$(jq -r .region <<<"$selection")"); fi
jq -n --arg session "$session" --arg file "$file" \
	--arg display "${WAYLAND_DISPLAY:?}" --arg desktop "${XDG_CURRENT_DESKTOP:-${XDG_SESSION_DESKTOP:-}}" \
	--arg sid "${XDG_SESSION_ID:-}" --arg mango "${MANGO_INSTANCE_SIGNATURE:-}" \
	--args '{session: $session, file: $file, environment: {WAYLAND_DISPLAY: $display, XDG_CURRENT_DESKTOP: $desktop, XDG_SESSION_ID: $sid, MANGO_INSTANCE_SIGNATURE: $mango}, args: $ARGS.positional}' -- "${args[@]}" >"$state/request.json"
systemctl --user reset-failed "$unit"
systemctl --user start "$unit" || fail 'Recorder startup failed; inspect the user journal.'
sleep 0.6
active || fail 'Recorder exited during startup; inspect the user journal.'
notify-send 'Recording started' "$file"
