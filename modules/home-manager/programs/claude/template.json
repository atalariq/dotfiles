{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(nix eval *)",
      "Bash(nix build *)",
      "Bash(nix flake check *)",
      "Bash(nixfmt *)",
      "Bash(just check)",
      "Bash(just fmt)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developers.openai.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:nixos.org)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh release *)",
      "Bash(nixos-rebuild *)",
      "Bash(darwin-rebuild *)",
      "Bash(home-manager switch *)",
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(pkexec *)",
      "Bash(/run/wrappers/bin/pkexec *)",
      "Bash(/run/wrappers/bin/sudo *)"
    ],
    "deny": [
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/age/**)",
      "Read(~/.config/sops/**)",
      "Read(~/.config/sops-nix/secrets/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.agekey)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.config/age",
        "~/.config/sops",
        "~/.config/sops-nix/secrets"
      ]
    },
    "network": {
      "allowedDomains": [
        "code.claude.com",
        "developers.openai.com",
        "docs.github.com",
        "nixos.org",
        "cache.nixos.org"
      ],
      "allowLocalBinding": false
    },
    "excludedCommands": [
      "sudo",
      "doas",
      "pkexec",
      "/run/wrappers/bin/sudo",
      "/run/wrappers/bin/pkexec"
    ]
  }
}
