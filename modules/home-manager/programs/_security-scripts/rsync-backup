#!/bin/sh
# A mirror is useful only when the destination is the intended mounted device.
set -eu
if [ "$#" -lt 1 ]; then
  echo "Usage: rsync-backup MOUNTPOINT [SOURCE ...]" >&2
  exit 2
fi
target=$1
shift
if ! mountpoint -q -- "$target"; then
  echo "Backup destination must be a mounted filesystem: $target" >&2
  exit 1
fi
if [ "$#" -eq 0 ]; then
  set -- "$HOME/Music" "$HOME/Videos"
fi
rsync --archive --human-readable --partial --info=stats1,progress2 --modify-window=1 -- "$@" "$target/"
printf 'Backup completed: %s\n' "$target"
