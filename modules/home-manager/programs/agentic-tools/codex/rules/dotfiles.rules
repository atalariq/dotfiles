# Routine commands use the workspace sandbox. These rules only restrict actions;
# no rule grants a command unrestricted host access.
prefix_rule(pattern = [["sudo", "doas", "pkexec", "/run/wrappers/bin/sudo", "/run/wrappers/bin/pkexec"]], decision = "prompt", justification = "Owner approval is required for privilege escalation.")
# Local staging/commits remain sandboxed and governed by the project's assignment.
# This policy cannot distinguish a main checkout from an assigned worktree.
prefix_rule(pattern = ["git", "push"], decision = "prompt", justification = "Publishing requires owner approval.", match = ["git push --dry-run origin HEAD"], not_match = ["git add -- file.nix", "git commit -m checkpoint", "git status --short"])
prefix_rule(pattern = ["gh", "pr", "create"], decision = "prompt", justification = "Publishing a pull request requires owner approval.")
prefix_rule(pattern = ["gh", "release"], decision = "prompt", justification = "Release operations require owner approval.")
prefix_rule(pattern = [["nixos-rebuild", "darwin-rebuild"]], decision = "prompt", justification = "System rebuild commands require owner review; use nix build for validation.")
prefix_rule(pattern = ["home-manager", "switch"], decision = "prompt", justification = "Home Manager activation requires owner approval.")
prefix_rule(pattern = ["just", ["apply-thinkpad-x13", "apply-macpro-m4", "apply-linux-lab", "apply-wsl-lab"]], decision = "prompt", justification = "Activation requires owner approval.")
prefix_rule(pattern = ["nix", "run"], decision = "prompt", justification = "Review runnable activation commands; nix eval and nix build remain routine.")
prefix_rule(pattern = ["env", ["sudo", "doas", "pkexec"]], decision = "prompt", justification = "Privilege escalation requires owner approval even through env.")
prefix_rule(pattern = ["env", "git", "push"], decision = "prompt", justification = "Publishing requires owner approval even through env.")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden", justification = "Preserve uncommitted work; inspect git diff and use an explicit reviewed patch.")
prefix_rule(pattern = ["git", "clean"], decision = "forbidden", justification = "Preserve untracked files; review and remove only named disposable artifacts.")
prefix_rule(pattern = ["rm", "-rf"], decision = "forbidden", justification = "Review and remove only named disposable artifacts.")
prefix_rule(pattern = ["sops", ["decrypt", "-d"]], decision = "forbidden", justification = "Keep decrypted credentials outside agent output and the Nix store.")
