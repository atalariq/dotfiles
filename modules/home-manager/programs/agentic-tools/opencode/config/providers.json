{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "providers": {
    "deepseek": {
      "name": "DeepSeek (direct API)",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": [
        "DEEPSEEK_API_KEY"
      ],
      "settings": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash (direct API)",
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "capabilities": {
            "tools": true
          },
          "body": {
            "thinking": {
              "type": "enabled"
            },
            "reasoning_effort": "high"
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (manual selection)",
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "capabilities": {
            "tools": true
          },
          "body": {
            "thinking": {
              "type": "enabled"
            },
            "reasoning_effort": "high"
          }
        }
      }
    },
    "openrouter": {
      "name": "OpenRouter (manual selection)",
      "env": [
        "OPENROUTER_API_KEY"
      ]
    }
  }
}
