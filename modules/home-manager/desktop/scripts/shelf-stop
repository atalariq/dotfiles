#!/bin/sh
# ExecStop must wait: Pluto can defer quit while a drag owns a compositor grab.
set -eu
pid=${1:?MAINPID required}
case "$pid" in '' | 0 | *[!0-9]*) exit 2 ;; esac
signature() {
	awk '{sub(/^.*\) /, ""); print $20 ":" $1}' "/proc/$pid/stat" 2>/dev/null
}
initial=$(signature) || exit 0
start=${initial%:*}
read -r uptime _ </proc/uptime
now=$(printf '%s' "$uptime" | tr -d .)
deadline=$((now + 1200))
timeout 12 pluto quit || {
	echo 'Pluto did not acknowledge quit' >&2
	exit 1
}
while current=$(signature); do
	[ "${current%:*}" = "$start" ] && [ "${current#*:}" != Z ] || exit 0
	read -r uptime _ </proc/uptime
	now=$(printf '%s' "$uptime" | tr -d .)
	if [ "$now" -ge "$deadline" ]; then
		echo 'Pluto graceful shutdown timed out; service stop failed.' >&2
		exit 1
	fi
	sleep 0.05
done
