#!/usr/bin/env bash
# Activate an already-built appearance variant. No builds or privileged actions.
set -euo pipefail
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles-theme"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/theme"
manifest="$config_dir/catalogue.json"
case "${1:-}" in
  list) jq -r '.themes[]' "$manifest" ;;
  current) cat "$config_dir/current" ;;
  set)
    [[ $# == 2 ]] || { echo 'Usage: dotfiles-theme set <name>' >&2; exit 2; }
    jq -e --arg name "$2" '.themes | index($name) != null' "$manifest" >/dev/null || { echo 'Unknown theme; run dotfiles-theme list.' >&2; exit 2; }
    [[ -L "$state_dir/root" ]] || { echo 'Activate the base Home Manager generation first.' >&2; exit 1; }
    mkdir -p "$state_dir"
    exec 9>"$state_dir/lock"
    flock 9
    root=$(readlink -f -- "$state_dir/root")
    "$root/specialisation/$2/activate"
    ;;
  *) echo 'Usage: dotfiles-theme list | current | set <name>' >&2; exit 2 ;;
esac
